TARGETNAME=PritrakDLP
TARGETTYPE=DRIVER
DRIVERTYPE=FS

# Include paths
INCLUDES=$(DDK_INC_PATH);..\common\shared

# Source files  
SOURCES=dlp_driver_core.c \
        dlp_policy_cache.c \
        dlp_process_tracker.c

# Libraries
TARGETLIBS=$(DDK_LIB_PATH)\fltmgr.lib \
           $(DDK_LIB_PATH)\ntstrsafe.lib

# Compiler flags
C_DEFINES=$(C_DEFINES) -DUNICODE -D_UNICODE -DPOOL_NX_OPTIN=1

# Minifilter registration
MINIFILTER=1

# Altitude (must be unique - register with Microsoft)
ALTITUDE=370030

# Load order group
LOAD_ORDER_GROUP=FSFilter Activity Monitor

# Driver characteristics
DRIVERCHARACTERISTICS=0x00000001

